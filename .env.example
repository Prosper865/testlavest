# Copy to .env.local and fill in. Never commit real keys.

# Live market news (stocks, company, and crypto headlines). Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# Signs session cookies. Required. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Postgres connection string. Required. Migrations in /migrations run automatically on first use.
# e.g. postgres://postgres:postgres@localhost:5432/aurevia (add ?sslmode=require for hosted databases)
DATABASE_URL=
DATABASE_POOL_MAX=10

# First admin account, created or reset with: pnpm admin:create
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Cloudinary private storage for ID documents and payment screenshots (Dashboard → API Keys).
# Files are uploaded only when a form is submitted, as authenticated (non-public) assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional top-level folder in your Cloudinary media library.
CLOUDINARY_FOLDER=aurevia
